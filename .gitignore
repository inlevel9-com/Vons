# Public source allowlist. New root paths stay local until explicitly reviewed.
/*
!/.gitignore
!/.gitattributes
!/.github/
!/README.md
!/CONTRIBUTING.md
!/CITATION.cff
!/LICENSE
!/NOTICE
!/pyproject.toml
!/configs/
!/docs/
!/sdk/
!/tests/
!/tools/
!/vons/

# Internal planning, historical claims and agent/session records stay local.
/docs/*
!/docs/KASI_INTEGRATION.md
!/docs/MODEL_CARD.md
!/docs/PUBLIC_RELEASE.md
!/docs/HUGGING_FACE.md
!/docs/LICENSING.md
!/docs/COMMUNITY.md
!/docs/HUB_PUBLISHING.md
!/docs/publications/
!/docs/assets/
/docs/publications/*
!/docs/publications/README.md
!/docs/publications/LICENSE.md
!/docs/publications/ARXIV.md
!/docs/publications/vons-paper-v1.1.pdf
!/docs/publications/vons-tech-report-v1.1.pdf
/docs/assets/*
!/docs/assets/inlevel9-signature.png
!/docs/assets/inlevel9-signature-dark.png
!/docs/assets/vons-logo.png
!/docs/assets/vons-extension-icon-16.png
!/docs/assets/vons-extension-icon-32.png
!/docs/assets/vons-extension-icon-48.png
!/docs/assets/vons-extension-icon-128.png
/configs/*
!/configs/pilot.json
!/configs/pilot-diffusion.json
!/configs/pilot-v2-direct.json
!/configs/pilot-v2-diffusion.json
!/configs/public-release.json
/sdk/*
!/sdk/typescript/
/sdk/typescript/*
!/sdk/typescript/README.md
!/sdk/typescript/LICENSE
!/sdk/typescript/package.json
!/sdk/typescript/package-lock.json
!/sdk/typescript/src/
!/sdk/typescript/test/
!/sdk/typescript/demo/
!/sdk/typescript/extension/

